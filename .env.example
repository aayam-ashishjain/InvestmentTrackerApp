# Google OAuth configuration for the backend
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/google/callback"

# Public app URL for the frontend callback redirect
APP_URL="http://localhost:3000"

# Secret used to encrypt the saved Google connection locally
APP_ENCRYPTION_KEY="32-character-secret-key-here"

# Render deployment notes:
# - Set APP_URL to the deployed frontend URL, for example https://your-app.onrender.com
# - Set GOOGLE_REDIRECT_URI to https://<your-render-backend-host>/api/google/callback
# - Keep the Google OAuth app authorized for both localhost and the deployed domain
